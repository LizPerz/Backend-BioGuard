# BioGuard API - Environment Variables
# Copy this file to .env and fill in your values

# Required - MongoDB Atlas connection string
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=BioGuard

# Required - JWT signing key (min 32 chars)
JWT_SECRET_KEY=<replace-with-a-strong-random-string-at-least-32-chars>

# Optional - Stripe payment processing
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional - Push notifications via Firebase Cloud Messaging
FIREBASE_SERVICE_ACCOUNT_JSON=<base64-encoded-json>
FIREBASE_PROJECT_ID=<project-id>

# Optional - Google OAuth
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# Optional - SMTP for transactional emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=<password>
SMTP_FROM=noreply@bioguard.app

# Optional - Wearable device MAC (default: wearos-001)
BIOMETRIC_MAC_ADDRESS=wearos-001
